/**
 * Cloudflare Worker configuration for WingPoint.
 *
 * `database_id` is the production D1 database (not a secret). If you ever
 * recreate it with `npm run db:create`, update the id on the `DB` binding —
 * Wrangler offers to add a new binding instead, which the app doesn't use.
 *
 * Secrets are NOT stored here. Set them with:
 *   npx wrangler secret put GOOGLE_CLIENT_ID
 *   npx wrangler secret put GOOGLE_CLIENT_SECRET
 *
 * Who can sign in is managed in the `allowed_emails` D1 table (see README).
 * `ALLOWED_EMAILS` is an optional extra comma-separated list; it is left empty
 * here because deploys re-apply it. For local dev use `.dev.vars`.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wingpoint",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  // Served only from the custom domain, which is kept out of the repo: CI
  // deploys with `--domain` from the CUSTOM_DOMAIN Actions secret (see
  // .github/workflows/deploy.yml). Manually: npm run deploy -- --domain <host>
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // In SPA mode, browser navigations are answered with index.html before
    // the Worker runs. API routes that the browser navigates to (the Google
    // OAuth start and callback) must always reach the Worker.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wingpoint",
      "database_id": "4570984e-5ba1-4ac6-a21d-d41388ad7438",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_EMAILS": ""
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
